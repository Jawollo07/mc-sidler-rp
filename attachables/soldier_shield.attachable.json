{
  "format_version": "1.20.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "siedler:soldier_shield",
      "item": {
        "minecraft:shield": "query.is_item_name_any('slot.inventory', 1, 'minecraft:shield')"
      },
      "materials": {
        "item": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "shield": "textures/entity/shield",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "shield": "geometry.soldier.equipment.shield"
      },
      "render_controllers": [
        "controller.render.soldier.shield"
      ]
    }
  }
}