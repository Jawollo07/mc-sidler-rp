{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "siedler:infantry",
      "min_engine_version": "1.26.0",
      "materials": { "default": "entity" },
      "textures": { "default": "textures/entity/soldier" },
      "geometry": { "default": "geometry.soldier.infantry" },
      "animations": {
        "idle": "animation.soldier.idle",
        "walk": "animation.soldier.infantry_walk",
        "attack": "animation.soldier.infantry_attack",
        "controller": "controller.animation.soldier"
      },
      "scripts": { "animate": ["controller"] },
      "render_controllers": ["controller.render.soldier"],
      "locators": {
        "head": { "head": [0, 4, 0] },
        "right_item": { "rightItem": [0, 0, 0] },
        "left_item": { "leftItem": [0, 0, 0] }
      },
      "enable_attachables": true,
      "held_item_ignores_lighting": true
    }
  }
}
