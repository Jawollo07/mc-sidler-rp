{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.soldier.infantry": {
      "initial_state": "default",
      "states": {
        "default": {
          "blend_transition": 0.2,
          "blend_via_shortest_path": true,
          "animations": [
            "pillager_look_at_target",
            "pillager_move",
            "pillager_bob",
            { "pillager_attack": "query.is_attacking" }
          ]
        }
      }
    },
    "controller.animation.soldier.archer": {
      "initial_state": "default",
      "states": {
        "default": {
          "blend_transition": 0.2,
          "blend_via_shortest_path": true,
          "animations": [
            "pillager_look_at_target",
            "pillager_move",
            "pillager_bob",
            { "pillager_crossbow_hold": "query.is_attacking" }
          ]
        }
      }
    },
    "controller.animation.soldier.cavalry": {
      "initial_state": "default",
      "states": {
        "default": {
          "blend_transition": 0.2,
          "blend_via_shortest_path": true,
          "animations": [
            "pillager_look_at_target",
            "pillager_move",
            "pillager_bob",
            { "pillager_attack": "query.is_attacking" }
          ]
        }
      }
    }
  }
}
