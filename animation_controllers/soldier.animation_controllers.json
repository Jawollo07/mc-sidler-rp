{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.soldier": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": ["idle"],
          "transitions": [
            { "attack": "query.is_attacking" },
            { "move": "query.is_moving" }
          ]
        },
        "move": {
          "animations": ["walk"],
          "transitions": [
            { "attack": "query.is_attacking" },
            { "default": "!query.is_moving" }
          ],
          "blend_transition": 0.08
        },
        "attack": {
          "animations": ["attack"],
          "transitions": [
            { "move": "query.is_moving && !query.is_attacking" },
            { "default": "!query.is_attacking" }
          ],
          "blend_transition": 0.05
        }
      }
    }
  }
}
