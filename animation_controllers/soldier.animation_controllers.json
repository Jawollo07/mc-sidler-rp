{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.soldier": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": ["idle"],
          "transitions": [
            { "move": "query.is_moving" }
          ]
        },
        "move": {
          "animations": ["walk"],
          "transitions": [
            { "default": "!query.is_moving" }
          ]
        }
      }
    }
  }
}
