{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.soldier": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": ["idle"],
          "transitions": [
            { "attack": "query.property('siedler:combat_state') == 'attack'" },
            { "move": "query.is_moving && query.property('siedler:combat_state') == 'move'" }
          ]
        },
        "move": {
          "animations": ["walk"],
          "transitions": [
            { "attack": "query.property('siedler:combat_state') == 'attack'" },
            { "default": "!query.is_moving || query.property('siedler:combat_state') != 'move'" }
          ],
          "blend_transition": 0.12
        },
        "attack": {
          "animations": ["attack"],
          "transitions": [
            { "move": "query.all_animations_finished && query.is_moving && query.property('siedler:combat_state') == 'move'" },
            { "default": "query.all_animations_finished && query.property('siedler:combat_state') != 'attack'" },
            { "default": "query.all_animations_finished" }
          ],
          "blend_transition": 0.08
        }
      }
    }
  }
}
